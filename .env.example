# --- Discord ---
# Developer Portal → your app → Bot → Reset Token → Copy.
# This is the BOT token, not the Client Secret and not the Application ID.
BOT_KEY=your-discord-bot-token

# Your test server's ID (right-click the server → Copy Server ID, with
# Developer Mode on). Makes slash commands appear INSTANTLY instead of taking
# up to an hour to sync globally. Leave blank in production.
DEV_GUILD_ID=

# --- LLM provider ---
# "deepseek" (default) or "ollama" (offline fallback for text generation).
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-deepseek-key
# Optional overrides — the defaults are usually right.
#
# MODEL CHOICE: everything runs on deepseek-v4-flash. deepseek-v4-pro costs
# exactly 3x on every axis, and flash at reasoning_effort="max" roughly matches
# pro at its default effort — so capability comes from the effort dial below,
# not from paying for a bigger model.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash                     # bulk journal analysis
# DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp   # the only model that reads charts
# DEEPSEEK_REASONING_MODEL=deepseek-v4-flash           # /psych_report deep:true
#
# REASONING EFFORT: "off" | "low" | "high" | "max".
# Thinking tokens bill as OUTPUT tokens, so this is the real cost dial.
# DEEPSEEK_JOURNAL_EFFORT=off    # extraction from a trade note — no reasoning needed
# DEEPSEEK_COACH_EFFORT=high     # applying the framework without drifting off it
# DEEPSEEK_DEEP_EFFORT=max       # reasoning over your state/outcome correlations
# LLM_TIMEOUT=180

# NOTE: Ollama is still required for RAG embeddings (nomic-embed-text).
# DeepSeek has no embeddings endpoint, so `/ask` and `/reindex` need it running.
# That is separate from OLLAMA_MODEL below, which is ONLY used if you set
# LLM_PROVIDER=ollama. A 27B model needs ~18GB, so it's a workstation fallback,
# not something the Pi can serve.
# OLLAMA_MODEL=qwen3.8:27b

# --- CouchDB ---
COUCHDB_URL=http://admin:password@127.0.0.1:5984

# --- TradingView webhook ---
WEBHOOK_PORT=8080
WEBHOOK_TOKEN=your-shared-secret
